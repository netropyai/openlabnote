{
  "name": "openlabnote",
  "version": "0.1.0",
  "description": "Turn your AI-assisted dev records (Claude Code, Codex, git) into daily research notes",
  "keywords": [
    "research-note",
    "lab-notebook",
    "eln",
    "연구노트",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/netropyai/openlabnote.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "openlabnote": "./dist/index.js",
    "oln": "./dist/index.js"
  },
  "files": [
    "dist",
    "instructions",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "picocolors": "^1.1.0",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
